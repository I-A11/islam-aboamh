<IfModule mod_headers.c>
  # Content-hashed JS/CSS chunks — cache forever, they never change
  <FilesMatch "^_next/static/.*\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML files — never cache, always fetch the latest chunk manifest
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>